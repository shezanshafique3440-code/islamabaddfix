# ---------------------------------------------------------------------------
# Islamabad Fix — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every integration below is optional except DATABASE_URL and AUTH_SECRET.
# When an integration is unset the app runs with that feature in an explicit
# "not configured" state — it does not fake success.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
DATABASE_URL="postgresql://isbfix:isbfix@localhost:5432/isbfix?schema=public"
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public base URL, used for links in emails/notifications and OpenGraph tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty to allow same-origin only (recommended).
CORS_ALLOWED_ORIGINS=""

# --- Auth tuning (optional; sensible defaults applied) ----------------------
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="2592000"
# Failed-login lockout
AUTH_MAX_FAILED_ATTEMPTS="8"
AUTH_LOCKOUT_MINUTES="15"

# --- AI assistant (optional) -----------------------------------------------
# AI_PROVIDER: anthropic | openai | none
# When unset/none the intake assistant falls back to a transparent rule-based
# classifier and the UI says so — it never pretends an LLM answered.
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_BASE_URL=""

# --- Maps (optional) -------------------------------------------------------
# MAPS_PROVIDER: google | mapbox | none
MAPS_PROVIDER="none"
MAPS_API_KEY=""
# Exposed to the browser only when a browser-side map is actually rendered.
NEXT_PUBLIC_MAPS_PROVIDER="none"
NEXT_PUBLIC_MAPS_API_KEY=""

# --- Object storage (optional; defaults to local disk driver) ---------------
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="islamabad-fix"
STORAGE_FORCE_PATH_STYLE="true"

# --- Email (optional) ------------------------------------------------------
# EMAIL_PROVIDER: resend | smtp | none
EMAIL_PROVIDER="none"
EMAIL_API_KEY=""
EMAIL_FROM="Islamabad Fix <no-reply@example.com>"
SMTP_URL=""

# --- WhatsApp (optional, P2) ----------------------------------------------
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# --- SMS (optional) -------------------------------------------------------
# SMS_PROVIDER: none | twilio | generic
SMS_PROVIDER="none"
SMS_API_KEY=""
SMS_SENDER_ID="ISBFIX"
# Twilio: the account SID that goes with the auth token in SMS_API_KEY.
SMS_ACCOUNT_SID=""
# `generic` is for the Pakistani aggregators, which each invent their own
# shape. Placeholders: {key} {to} {text} {from}
#   SMS_GATEWAY_URL="https://api.aggregator.pk/send?api_key={key}&to={to}&from={from}&msg={text}"
# For a POST gateway, add a body template and its content type:
#   SMS_GATEWAY_METHOD="POST"
#   SMS_GATEWAY_CONTENT_TYPE="application/json"
#   SMS_GATEWAY_BODY='{"apikey":"{key}","msisdn":"{to}","message":"{text}"}'
#   SMS_GATEWAY_HEADERS="X-Account: isbfix"
SMS_GATEWAY_URL=""
SMS_GATEWAY_METHOD="GET"
SMS_GATEWAY_BODY=""
SMS_GATEWAY_CONTENT_TYPE="application/x-www-form-urlencoded"
SMS_GATEWAY_HEADERS=""

# --- Voice agent (optional, P2) -------------------------------------------
VAPI_API_KEY=""
VAPI_WEBHOOK_SECRET=""

# --- Payments (optional; Cash on Service always available) ----------------
# PAYMENT_GATEWAY: none | generic
#
# `generic` posts a signed checkout request and follows the redirect the
# gateway answers with — the shape JazzCash, Easypaisa and Safepay share.
# The field names differ between them: test against your gateway's sandbox
# before taking a real payment.
PAYMENT_GATEWAY="none"
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_CHECKOUT_URL=""
PAYMENT_MERCHANT_ID=""
# Signs the outgoing checkout request. Falls back to PAYMENT_API_KEY.
PAYMENT_SIGNING_SECRET=""

# --- Seeding -------------------------------------------------------------
# Used by `npm run db:seed`. Change before seeding anything reachable.
SEED_ADMIN_EMAIL="admin@islamabadfix.pk"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
# Refuse to seed demo data unless explicitly allowed (guards production).
ALLOW_DEMO_SEED="true"

# ----------------------------------------------------------------- web push
# The one integration that needs no account with anybody: generate the pair
# with `npm run vapid:keys` and push notifications work. Browsers accept the
# key because the server signs a JWT with it, not because anyone issued it.
#
# Rotating these invalidates every existing subscription — each browser is
# bound to the public key it was given — so everyone must re-enable
# notifications. Plan it rather than discover it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who a push service should contact about this server. mailto: or https:.
VAPID_SUBJECT="mailto:ops@islamabadfix.pk"

# ---------------------------------------------------------------- scheduling
# Shared secret for POST /api/cron/recurring, which generates due repeat visits
# and retires lapsed memberships. Without it that endpoint refuses every caller.
# Point any scheduler at it with: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# ------------------------------------------------------------------- calling
# Masked calling between customer and technician. Without a provider the app
# hands over the real number it already shares after a booking is accepted,
# and says so in the UI rather than pretending the call is masked.
#
# How it works, because it inverts what people expect: the platform rings the
# *caller* first, and joins the two legs once they answer. Neither handset ever
# receives the other's number, and there is no inbound routing to get wrong.
CALLING_PROVIDER=none        # none | twilio | vonage
CALLING_API_KEY=             # twilio: auth token
CALLING_FROM_NUMBER=         # the platform number both legs originate from
CALLING_ACCOUNT_SID=         # twilio only
CALLING_APPLICATION_ID=      # vonage only
CALLING_PRIVATE_KEY=         # vonage only, PKCS#8 PEM (\n for newlines)
